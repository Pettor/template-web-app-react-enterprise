{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "extends": [":semanticCommits", "config:recommended"],
  "labels": ["dependency", "bot"],
  "packageRules": [
    {
      "groupName": "dependencies",
      "groupSlug": "prod-deps",
      "matchDatasources": ["npm"],
      "matchDepTypes": [
        "dependencies",
        "pnpm.catalog.common",
        "pnpm.catalog.design",
        "pnpm.catalog.tanstack",
        "pnpm.catalog.validation",
        "pnpm.catalog.react19"
      ],
      "minimumReleaseAge": "7 days",
      "semanticCommitType": "fix",
      "separateMajorMinor": false,
      "separateMultipleMajor": false
    },
    {
      "groupName": "dev dependencies",
      "groupSlug": "dev-deps",
      "matchDatasources": ["npm"],
      "matchDepTypes": [
        "devDependencies",
        "pnpm.catalog.eslint",
        "pnpm.catalog.vite",
        "pnpm.catalog.typescript",
        "pnpm.catalog.storybook",
        "pnpm.catalog.vitest",
        "pnpm.catalog.playwright",
        "pnpm.catalog.mocks",
        "pnpm.catalog.coverage",
        "pnpm.catalog.tailwind"
      ],
      "minimumReleaseAge": "7 days",
      "semanticCommitType": "chore",
      "separateMajorMinor": false,
      "separateMultipleMajor": false
    },
    {
      "groupName": "dev dependencies",
      "groupSlug": "dev-deps",
      "matchDatasources": ["npm"],
      "matchDepNames": ["@faker-js/faker", "@formatjs/cli", "cross-env", "move-cli", "rimraf", "workbox-window"],
      "minimumReleaseAge": "7 days",
      "semanticCommitType": "chore",
      "separateMajorMinor": false,
      "separateMultipleMajor": false
    }
  ],
  "schedule": ["every weekend"]
}