{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "extends": [":semanticCommits"],
  "labels": ["dependency", "bot"],
  "packageRules": [
    {
      "groupName": "dependencies",
      "matchDatasources": ["npm"],
      "matchDepTypes": ["dependencies", "peerDependencies", "common", "react19", "design", "tanstack", "validation"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "digest", "lockFileMaintenance", "rollback", "bump"],
      "minimumReleaseAge": "7 days",
      "semanticCommitType": "fix"
    },
    {
      "groupName": "dev dependencies",
      "matchDatasources": ["npm"],
      "matchDepTypes": ["devDependencies", "eslint", "storybook", "playwright", "vite", "vitest", "mocks", "coverage", "typescript"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "digest", "lockFileMaintenance", "rollback", "bump"],
      "minimumReleaseAge": "7 days",
      "semanticCommitType": "chore"
    }
  ],
  "schedule": ["every weekend"],
  "separateMajorMinor": false
}
